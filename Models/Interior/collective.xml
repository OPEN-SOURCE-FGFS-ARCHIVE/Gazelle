<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>
<!-- for UH-60 HD -->
 
 

    
    <path>collective2.ac</path>
 
 
  <animation>
    <type>rotate</type>
    <object-name>collective2</object-name>
	<object-name>Landing lights</object-name>
    <property>controls/engines/engine[0]/throttle</property>
    <factor> -20</factor>
    <offsets>
      <x-m> 0 </x-m>
      <y-m>0</y-m>
      <z-m>0</z-m>
    </offsets>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>
  
  
  
   <model>
		<name>Landing lights</name>
    <path>Aircraft/Gazelle/Models/Interior/Instruments/switches/landing-lights.xml</path>
    <offsets> 
    <x-m>-0.212</x-m>
   <y-m>-0.008</y-m>
   <z-m>0.108</z-m>
   <pitch-deg>-70</pitch-deg>

    </offsets>
	<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.7</y-offset>
    <z-offset>0.7</z-offset>
   </animation>
  </overlay>
	</model>
	
	<animation>
    <type>select</type>
    <object-name>NoseGearLandinglight</object-name>
    <object-name>Taxi-Light-Left</object-name>
         
    <condition>
      <equals>
        <property>controls/switches/landing-lights-switch</property>
        <value> 1 </value>
      </equals>
    </condition>
  </animation> 	

</PropertyList>

