  <animation>
  <type>material</type>
  <object-name>radio1</object-name>
 
 
  <ambient>
    <red>1.0</red>
    <green>1.0</green>
    <blue>1.0</blue>
  </ambient>
  <diffuse>
    <red>0.1</red>
