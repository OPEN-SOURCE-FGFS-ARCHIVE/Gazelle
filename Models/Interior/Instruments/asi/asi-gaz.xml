<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>asi-gaz.ac</path>
	
  <animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle1</object-name>
  </animation>

 


  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle1</object-name>
    <emission>
            <red>   0.005 </red>
      <green> 0.015 </green>
      <blue>  0.030 </blue>
	 
      <factor-prop>systems/electrical/outputs/instrument-lights</factor-prop>
    </emission>
  </animation>
	
  <animation>
    <type>rotate</type>
    <object-name>needle1</object-name>
    
<property>sim/multiplay/generic/float[14]</property>
     <interpolation>
      <entry><ind> -999 </ind><dep>   0 </dep></entry>
      <entry><ind>    0 </ind><dep>   0 </dep></entry>
      <entry><ind>   30 </ind><dep>  34 </dep></entry>
      <entry><ind>   40 </ind><dep>  62 </dep></entry>
      <entry><ind>   50 </ind><dep>  92 </dep></entry>
      <entry><ind>   60 </ind><dep> 117 </dep></entry>
      <entry><ind>   70 </ind><dep> 139 </dep></entry>
      <entry><ind>   80 </ind><dep> 161 </dep></entry>
      <entry><ind>   90 </ind><dep> 180 </dep></entry>
      <entry><ind>  100 </ind><dep> 196 </dep></entry>
      <entry><ind>  110 </ind><dep> 212 </dep></entry>
      <entry><ind>  120 </ind><dep> 227 </dep></entry>
      <entry><ind>  130 </ind><dep> 242 </dep></entry>
      <entry><ind>  140 </ind><dep> 255 </dep></entry>
      <entry><ind>  150 </ind><dep> 268 </dep></entry>
      <entry><ind>  170 </ind><dep> 297 </dep></entry>
      <entry><ind>  200 </ind><dep> 339 </dep></entry>
      <entry><ind>  999 </ind><dep> 359 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>
  
  
   <!-- Coompositor lights -->
  
  <light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.02</x-m>
    <y-m>0.0</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>0.0</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.50</r>
      <g>0.15</g>
      <b>0.6</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>1</spot-exponent>
  <spot-cutoff>70</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.2</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights</property>
  </dim-factor>
 
</light>

<animation>
  <type>select</type>
  <object-name>dash1</object-name>
		
  <condition>
  
   <equals>
    <property>controls/lighting/turn-off-lights</property>
    <value>true</value>
   </equals>
  
  </condition>
 </animation>

</PropertyList>

