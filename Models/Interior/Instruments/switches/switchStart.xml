<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>
	<path>switchStart.ac</path>
	
	<animation>
		<type>material</type>
		<object-name>cover</object-name>
		<object-name>plate1</object-name>
		<object-name>plate2</object-name>
		<emission>
			<factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
			  <red>0.001</red>
        <green>0.001</green>
        <blue>0.001</blue>
		</emission>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>Switch</object-name>
		<property>engines/engine/starting/switch-angle</property>
		<factor> 1 </factor>
		<axis>
			<x> 0 </x>
			<y> 1 </y>
			<z> 0 </z>
		</axis>
	</animation>

<animation>
    <type>pick</type>
    <object-name>Switch</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
    <binding>
					<command>nasal</command>
					<script>bo105.startup()</script>
					<condition>
						<property>/sim/signals/fdm-initialized</property>
					</condition>
					</binding>
    </action>
  </animation>
  
</PropertyList>
