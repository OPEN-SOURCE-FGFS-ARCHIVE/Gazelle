<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>fuelqty.ac</path>
	
	<!--effect>
		<inherits-from>Effects/model-transparent</inherits-from>
		<condition>
			<property>/sim/rendering/rembrandt/enabled</property>
		</condition>
		<object-name>face</object-name> 
		<object-name>needle</object-name> 
	</effect-->

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>
   <emission>
            <red>   0.005 </red>
      <green> 0.015 </green>
      <blue>  0.030 </blue>
      <factor-prop>systems/electrical/outputs/instrument-lights</factor-prop>
    </emission>
  </animation>
	
  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
   <!-- <property>/consumables/fuel/tank/level-lbs</property>-->
   <property>sim/multiplay/generic/float[11]</property>
    <interpolation>
      <entry><ind>   0 </ind><dep> -118 </dep></entry>
      <entry><ind>  88 </ind><dep>  -60 </dep></entry>
      <entry><ind> 220 </ind><dep>   -8 </dep></entry>
      <entry><ind> 330 </ind><dep>   32 </dep></entry>
      <entry><ind> 440 </ind><dep>   78 </dep></entry>
      <entry><ind> 660 </ind><dep>  142 </dep></entry>
      <entry><ind> 770 </ind><dep>  172 </dep></entry>
      <entry><ind> 801 </ind><dep>  190 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

	<animation>
		<type>range</type>
		<min-m>0</min-m>
		<max-m>5</max-m>
	</animation>
	
	<light>
  <name>dash1</name>
  <type>spot</type>
  <position>
    <x-m>0.02</x-m>
    <y-m>0.0</y-m>
    <z-m>0</z-m>
  </position>
  <direction>
    <x>-1.0</x>
    <y>0</y>
    <z>0</z>
  </direction>
  <ambient>
    <r>0</r>
    <g>0</g>
    <b>1</b>
    <a>1</a>
  </ambient>
  <diffuse>
    <r>0</r>
    <g>1</g>
    <b>0</b>
    <a>1</a>
  </diffuse>
  <specular>
    <r>0</r>
    <g>0.0</g>
    <b>0</b>
    <a>1</a>
  </specular>
    <color>
      <r>0.50</r>
      <g>0.15</g>
      <b>0.6</b>
      <a>1.0</a>
    </color>
 <attenuation>
    <c>1</c>
    <l>1.5</l>
    <q>3.5</q>
  </attenuation>
  <spot-exponent>4</spot-exponent>
  <spot-cutoff>70</spot-cutoff>
  <range-m>0.05</range-m>
   <intensity>0.2</intensity>
  <dim-factor>
    <property>systems/electrical/outputs/instrument-lights</property>
  </dim-factor>
 
</light>

<animation>
  <type>select</type>
  <object-name>dash1</object-name>
		
  <condition>
  
   <equals>
    <property>controls/lighting/turn-off-lights</property>
    <value>true</value>
   </equals>
  
  </condition>
 </animation>

</PropertyList>

