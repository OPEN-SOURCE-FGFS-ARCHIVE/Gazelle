 <!-- text for radios etc --> 

  <animation>
  <type>material</type>
  <object-name>radio1</object-name>
 
 
  <ambient>
    <red>1.0</red>
    <green>1.0</green>
    <blue>1.0</blue>
  </ambient>
  <diffuse>
    <red>0.1</red>
    <green>0.1</green>
    <blue>0.1</blue>
  </diffuse>
  <emission>
    <red>0.8</red>
    <green>0.8</green>
    <blue>0.8</blue>
  </emission> 
 </animation> 
 
 
 <text>
  <name>radio1</name>
  <font>lcd.txf</font>
  <character-size type="double">0.011</character-size>
  <offsets>
   <x-m>-4.3567</x-m>
   <y-m>0.0425</y-m>
   <z-m>-0.565</z-m>
 <pitch-deg>-25</pitch-deg>
  </offsets>
  <axis-alignment>yz-plane</axis-alignment>
  <type type="string">number-value</type>
  <format type="string">%3.2f</format>
  <truncate type="bool">false</truncate>
 <property>instrumentation/comm[0]/frequencies/selected-mhz</property>
  <alignment>right-top</alignment>
 </text>
 
 
  <animation>
  <type>material</type>
  <object-name>Lat</object-name>
 
  <object-name>Long</object-name>
 
   
 
  <ambient>
    <red>0.0</red>
    <green>1.0</green>
    <blue>0.0</blue>
  </ambient>
  <diffuse>
    <red>0.0</red>
    <green>0.1</green>
    <blue>0.0</blue>
  </diffuse>
  <emission>
    <red>0.3</red>
    <green>0.8</green>
    <blue>0.3</blue>
  </emission> 
 </animation>
 
 
 <text>
  <name>Lat</name>
  <font>lcd.txf</font>
  <character-size type="double">0.007</character-size>
