   <model>
		<name>Nav Lights</name>
    <path>Aircraft/Gazelle/Models/Interior/Instruments/switches/nav.xml</path>
    <offsets> 
    <x-m>-4.473</x-m>
   <y-m>-0.0495</y-m>
   <z-m>-0.187</z-m>
   <pitch-deg>-0</pitch-deg>

    </offsets>
	<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1.3</x-offset>
    <y-offset>1.1</y-offset>
    <z-offset>1.1</z-offset>
   </animation>
  </overlay>
	</model>
	
	<animation>
    <type>select</type>
    <object-name>GreenLightFlare</object-name>
    <object-name>GreenLightRemb</object-name>
	 <object-name>RedLightFlare</object-name>
    <object-name>RedLightRemb</object-name>
	<object-name>WhiteLightFlare</object-name>
    <object-name>WhiteLightRemb</object-name>
         
    <condition>
      <equals>
        <property>controls/switches/nav-lights-switch</property>
