    <!-- Main Rotor -->
    <filter>
        <name>rotor-in</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <expression>
                <log10>
                    <table>
                        <property>/rotors/main/rpm</property>
                        <entry>
                            <ind>7.4896443808</ind>
                            <dep>1</dep>
                        </entry>
                        <entry>
                            <ind>395</ind>
                            <dep>10</dep>
                        </entry>
                    </table>
                </log10>
            </expression>
        </input>
        <output>
            <property>/sounds/Gazelle/rotors/rotor-in</property>
        </output>
    </filter>

    <!-- Wind -->
    <filter>
        <name>wind-in</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <expression>
                <log10>
                    <table>
                        <property>/velocities/airspeed-kt</property>
                        <entry>
                            <ind>7.775374</ind>
                            <dep>1</dep>
                        </entry>
                        <entry>
                            <ind>68.5</ind>
                            <dep>2.5</dep>
                        </entry>
                        <entry>
                            <ind>137</ind>
                            <dep>10</dep>
                        </entry>
                    </table>
                </log10>
            </expression>
        </input>
        <output>
            <property>/sounds/EC135/environment/wind-in</property>
        </output>
    </filter>

