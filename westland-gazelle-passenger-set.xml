			  <file>Aircraft/Instruments-3d/ki266/ki266.nas</file>
			  
		</bo105>
	<terrain-map>
 <file>Aircraft/Gazelle/Nasal/terrain-map.nas</file>
 </terrain-map>	
		
 </nasal>

</PropertyList>
