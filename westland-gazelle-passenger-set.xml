<!--
  Usage: fgfs - -prop:/sim/remote/pilot-callsign="remote pilot callsign" - -aircraft=Fi-156-passenger
-->
<PropertyList>

 <sim>

  <description>Westland_Gazelle Multiplayer passenger</description>
  <author>Anders Gidenstam</author>
  <status>alpha</status>
  <aircraft-version>$Id$</aircraft-version>
  
  <flight-model>null</flight-model>

  <presets>
   <onground type="bool">false</onground>
   <altitude-agl-ft type="double">30.0</altitude-agl-ft>
  </presets>
  
  <startup>
			<splash-texture>Aircraft/Gazelle/splash.jpg</splash-texture>
		</startup>

<previews>
	  <preview>
		<type>interior</type>
		<splash type="bool">true</splash>
		<path>SplashW/splash.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>SplashW/splash1.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>SplashW/splash2.png</path>
	  </preview>
	  <preview>
		<type>interior</type>
		<splash type="bool">true</splash>
		<path>SplashW/splash3.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>SplashW/splash4.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>SplashW/splash5.png</path>
	  </preview>
	</previews>	
		
	  <systems>
      <electrical>
        <path>Aircraft/Generic/generic-electrical.xml</path>
      </electrical>
	  
       <autopilot>
        <path>Aircraft/Gazelle/System/glass-rain.xml</path>
      </autopilot>
    </systems> 		
		
		

  <!-- 3d model -->
  <model>
   <path>Aircraft/Gazelle/Models/Gazelle-Passenger.xml</path>
  </model>
   <rendering>
		<refl_correction type="string">-0.4</refl_correction>
		<fresnel-factor>0.7</fresnel-factor>
	</rendering>
  
  <multiplay>
   <generic>
    <float n="0" alias="/controls/engines/engine[0]/throttle" />
	
    <int n="0" type="int">0</int>
	
	<string n="0" type="string">0</string>
   </generic>
  </multiplay>

  <!-- Views -->
  <view n="0">
   <!-- Passenger's position. -->
   <name>Copilot View</name>
   <type>lookfrom</type>
   <config>
    <internal type="bool">true</internal>
    <from-model type="bool">false</from-model>
    <from-model-idx type="int">0</from-model-idx>
    <eye-lat-deg-path>/position/latitude-deg</eye-lat-deg-path>
    <eye-lon-deg-path>/position/longitude-deg</eye-lon-deg-path>
    <eye-alt-ft-path>/position/altitude-ft</eye-alt-ft-path>
    <eye-heading-deg-path>/orientation/heading-deg</eye-heading-deg-path>
    <eye-pitch-deg-path>/orientation/pitch-deg</eye-pitch-deg-path>
    <eye-roll-deg-path>/orientation/roll-deg</eye-roll-deg-path>

    <!-- x/y/z == right/up/back -->
                <x-offset-m archive="y">-0.34</x-offset-m><!--right-->
				<y-offset-m archive="y">0.68</y-offset-m><!--up-->
				<z-offset-m archive="y">-1.63</z-offset-m><!--back-->
				<pitch-offset-deg archive="y">-6</pitch-offset-deg>
				<default-field-of-view-deg>110</default-field-of-view-deg>
   </config>
  </view>
  <!-- Views -->
  <view n="100">
			<name>Belly View</name>
			<enabled type="bool">false</enabled>
			<type>lookfrom</type>
			<internal archive="y">true</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">0</x-offset-m>    <!-- right? -->
				<y-offset-m archive="y">-1</y-offset-m>   <!-- up -->
				<z-offset-m archive="y">3.5</z-offset-m>  <!-- back -->
				<pitch-offset-deg>0</pitch-offset-deg>
				<ground-level-nearplane-m type="double">0.05f</ground-level-nearplane-m>
				<default-field-of-view-deg type="double">55.0</default-field-of-view-deg>
				<default-pitch-deg type="double">-15</default-pitch-deg>
				<default-heading-deg type="double">0</default-heading-deg>
				<front-direction-deg type="double">0</front-direction-deg>
				<front-left-direction-deg type="double">45</front-left-direction-deg>
				<left-direction-deg type="double">90</left-direction-deg>
				<back-left-direction-deg type="double">135</back-left-direction-deg>
				<back-direction-deg type="double">180</back-direction-deg>
				<back-right-direction-deg type="double">225</back-right-direction-deg>
				<right-direction-deg type="double">270</right-direction-deg>
				<front-right-direction-deg type="double">315</front-right-direction-deg>
				<default-field-of-view-deg>55</default-field-of-view-deg>
			</config>
		</view>
		
		
		 <view n="101">
    <name>Pilot cam</name>
        <internal archive="y">false</internal>
        <config>
		 <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
         <x-offset-m archive="y">0.0</x-offset-m><!--right-->
		 <y-offset-m archive="y">0.7</y-offset-m><!--up-->
		 <z-offset-m archive="y">-2.2</z-offset-m><!--back-->
          <pitch-offset-deg>0</pitch-offset-deg>
		  <heading-offset-deg>199</heading-offset-deg>
          <default-field-of-view-deg>110</default-field-of-view-deg>
        </config>
     
  </view>
  
  
  	<view n="102">
			<name>Over the shoulder</name>
			<internal archive="y">false</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">0.52</x-offset-m><!--right-->
				<y-offset-m archive="y">0.8</y-offset-m><!--up-->
				<z-offset-m archive="y">-1.0</z-offset-m><!--back-->
				<pitch-offset-deg>-14</pitch-offset-deg>
				<heading-offset-deg>10</heading-offset-deg>
				<default-field-of-view-deg>65</default-field-of-view-deg>
			</config>
		</view>
		
		<view n="103">
			<name>Sight Optics</name>
			<internal archive="y">false</internal>
			<config>
				<from-model type="bool">true</from-model>
				<from-model-idx type="int">0</from-model-idx>
				<x-offset-m archive="y">-0.3</x-offset-m><!--right-->
				<y-offset-m archive="y">1.3</y-offset-m><!--up-->
				<z-offset-m archive="y">-1.6</z-offset-m><!--back-->
				<pitch-offset-deg>0</pitch-offset-deg>
				<heading-offset-deg>0</heading-offset-deg>
				<default-field-of-view-deg>65</default-field-of-view-deg>
				<limits>
					<enabled type="bool">true</enabled>
					<left>
						<heading-max-deg type="double">100</heading-max-deg>
						<x-offset-max-m type="double">0.20</x-offset-max-m>
						<x-offset-threshold-deg type="double">25</x-offset-threshold-deg>
					</left>
					<right>
						<heading-max-deg type="double">100</heading-max-deg>
						<x-offset-max-m type="double">0.20</x-offset-max-m>
						<x-offset-threshold-deg type="double">25</x-offset-threshold-deg>
					</right>
					</limits>
			</config>
	         <flir type="bool">true</flir>

		</view>
 <view n="1">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="2">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="3">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="4">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="5">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <view n="6">
    <config>
      <target-z-offset-m archive="y" type="double"> 0 </target-z-offset-m>
    </config>
  </view>

  <chase-distance-m type="double">-18.0</chase-distance-m>
<sound>
			<path>Aircraft/Gazelle/Sounds/sound.xml</path>
		</sound>
		
<hud>
   <path n="1">Aircraft/Gazelle/Hud/hud.xml</path>
   <visibility n="1">true</visibility>
   
   <palette>
    <color n="0">
     <alpha type="float">0.85</alpha>
     <antialiased type="bool">true</antialiased>
     <brightness type="float">0.85</brightness>
     <transparent type="bool">true</transparent>
     <red type="float">0.38</red>
     <green type="float">0.38</green>
     <blue type="float">0.22</blue>
    </color>
    
   </palette>
   
  </hud>	

	<weight n="5">
			<name>NOT USED</name>
			<weight-lb>0</weight-lb>
<selected>none</selected>
<opt>
<name>none</name>
<lbs>0</lbs>
</opt>
		</weight>  
		
		<flir>
			<view type="int">103</view>
			<weight type="int">5</weight>
			<options>
				<name>none</name>
			</options>
		</flir>	

  <!-- Aircraft specific help. -->
  <!-- help include="help.xml"/ -->

  <!-- systems>
   <electrical>
    <path/>
   </electrical>
  </systems>
  <instrumentation>
   <path/>
  </instrumentation -->

  <menubar>
   <default>
    <menu n="100">
     <label>Gazelle</label>
     <item>
      <label>Select MP-pilot</label>
      <binding>
       <command>nasal</command>
       <script>
        dual_control_tools.
          copilot_dialog.show(aircraft_dual_control.pilot_type);
       </script>
      </binding>
     </item>
    </menu>
   </default>
  </menubar>

 </sim>
 
  <environment>
    
	<precipitation-control>
            <clip-distance type="double">1.75</clip-distance>
        </precipitation-control>
  </environment>

  
 

		<engines>
			<engine n="0">
				<magnetos>1</magnetos>
				<propeller-pitch alias="/controls/engines/power-trim"/>
				<mixture alias="/controls/engines/power-balance"/>
			</engine>

			<engine n="1">
				<magnetos>1</magnetos>
				<propeller-pitch alias="/controls/engines/power-trim"/>
				<mixture alias="/controls/engines/power-balance"/>
				<throttle alias="/controls/engines/engine[0]/throttle"/>
			</engine>

			<power-trim type="double">0</power-trim>
			<power-balance type="double">0</power-balance>
		</engines>

	
	 <controls include="gazelle-controls.xml">
	 <rotor>
			<reltarget type="double">0</reltarget>
			<maxreltorque type="double">0</maxreltorque>
		</rotor>

		<armament>
			<trigger type="bool">false</trigger>
		</armament>
		
		<lighting>
			<strobe type="bool">true</strobe>
			<beacon type="bool">true</beacon>
			<nav-lights type="bool">true</nav-lights>
		</lighting>
	</controls>
	
		<instrumentation>
		<gsdi>
			<serviceable type="bool">true</serviceable>
		</gsdi>
		<hsi>
			<serviceable type="bool" archive="y">true</serviceable>
		</hsi>
		
		 <efis>

			<ecam>
					<display-mode type="string">FUEL</display-mode>
			</ecam>
			<nd>
					<display-mode type="string">VOR</display-mode>
					<display-mode-knob type="int">2</display-mode-knob>
					<display-range type="int">10</display-range>
				
			</nd>
			<input>
				<vor-adf-1 type="int">1</vor-adf-1>
				<vor-adf-2 type="int">1</vor-adf-2>
				<CSTR type="bool">1</CSTR>
				<WPT type="bool">1</WPT>
				<VORD type="bool">1</VORD>
				<NDB type="bool">1</NDB>
				<ARPT type="bool">1</ARPT>
				<WX type="bool">1</WX>
				<TERR type="bool">1</TERR>
				<TRAF type="bool">1</TRAF>
				<taxi type="bool">1</taxi>
			</input>

		
		</efis>
	</instrumentation>

	<input>
		<keyboard include="Input/keyboard-gaz-W.xml" />
	</input>

 <nasal>
<flir>
			<file>Aircraft/Gazelle/Nasal/flir.nas</file>
		</flir>	
	<rotorwash>
	<file>Aircraft/Gazelle/Nasal/rotorwash.nas</file>
	</rotorwash>
  <dual_control_tools>
   <file>Aircraft/Generic/DualControl/dual-control-tools.nas</file>
  </dual_control_tools>
  <aircraft_dual_control>
   <file>Aircraft/Gazelle/Nasal/wgazelle-dual-control.nas</file>
  </aircraft_dual_control>
  <dual_control>
   <file>Aircraft/Generic/DualControl/copilot-dual-control.nas</file>
  </dual_control>
 <bo105>
 <script>
  
   props.globals.getNode("sim/multiplay/generic/float[2]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/float[3]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/float[4]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/float[5]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/float[6]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/float[7]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/float[8]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/float[9]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/float[10]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/int[4]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/int[5]",1).setValue(0);
   props.globals.getNode("sim/multiplay/generic/int[7]",1).setValue(0);
  </script>
 
 
